# NutriPack — environment variables
# Copy to .env and adjust. NEVER commit real secrets.

# ==== Core ====
# NODE_ENV: 'production' for deployments. Port comes from the start script (-p 3100).
NODE_ENV=development

# ==== Auth (REQUIRED at runtime) ====
# HMAC secret for signed session tokens. The server REFUSES token operations
# without a strong value. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-in-production

# ==== Routing (Route Intelligence) ====
# OSRM-compatible router base URL. Default uses the public demo server
# (router.project-osrm.org, open data © OpenStreetMap contributors — OSM is the
# map data source, OSRM is the router). If unreachable, the app falls back to a
# clearly-labelled great-circle estimate — never fabricated router data.
# Self-host option: docker run -p 5000:5000 osrm/osrm-backend ...
OSRM_BASE_URL=

# ==== Database ====
# NutriPack ships with an embedded JSON document store (data/nutripack.json):
# zero external services, atomic writes, in-memory cache. For PostgreSQL
# deployment, set DATABASE_URL and follow the normalized schema in DATABASE.md.
DATABASE_URL=

# ==== Optional external services ====
# Python ML microservice (FastAPI). Empty = built-in deterministic engines.
ML_SERVICE_URL=
# Vision provider for image commodity identification. Empty = deterministic
# demo classifier whose output is explicitly labelled 'demo-classifier'.
VISION_PROVIDER=
VISION_API_KEY=
